    {
      "id": "markings-foal",
      "title": "Face markings",
      "order": 30,
      "dependsOn": ["coat-foal", "pie-foal"],
      "options": [
        {
          "id": "blaze",
          "title": "Blaze (liste)",
          "asset": "layers/markings/Foal/blaze.png"
        },
        {
          "id": "thin-blaze",
          "title": "Thin blaze (fine liste)",
          "asset": "layers/markings/Foal/thin-blaze.png"
        },
        {
          "id": "stripe",
          "title": "Stripe (race)",
          "asset": "layers/markings/Foal/stripe.png"
        },
        {
          "id": "star",
          "title": "Star (étoile)",
          "asset": "layers/markings/Foal/star.png"
        },
        {
          "id": "diamond",
          "title": "Diamond (lozange)",
          "asset": "layers/markings/Foal/diamond.png"
        },
        {
          "id": "heart",
          "title": "Heart (cœur)",
          "asset": "layers/markings/Foal/heart.png"
        },
        {
          "id": "snip",
          "title": "Snip (pelote)",
          "asset": "layers/markings/Foal/snip.png"
        },
        {
          "id": "star-snip",
          "title": "Star and snip",
          "asset": "layers/markings/Foal/star-snip.png"
        },
        {
          "id": "bald",
          "title": "Bald face (grosse liste)",
          "asset": "layers/markings/Foal/bald.png"
        },
        {
          "id": "crescent",
          "title": "Crescent (croissant)",
          "asset": "layers/markings/Foal/crescent.png"
        }
      ]
    },
    {
      "id": "mane",
      "title": "Mane",
      "order": 40,
      "required": true,
      "dependsOn": ["body"],
      "options": [
        { "id": "short", "title": "Short", "asset": "layers/mane/short.png" },
        { "id": "long", "title": "Long", "asset": "layers/mane/long.png" }
      ]
    },
    {
      "id": "equipment",
      "title": "Equipment",
      "order": 50,
      "options": [
        {
          "id": "saddle",
          "title": "Saddle",
          "asset": "layers/equipment/saddle.png"
        },
        {
          "id": "armor",
          "title": "Plate armour",
          "asset": "layers/equipment/armor.png"
        }
      ]
    }
  ],
  "constraints": [
    {
      "id": "body-not-painted-standard",
      "description": "Coat layers carry the full silhouette; the build axis is selection-only",
      "when": { "body": "standard" },
      "hide": ["body"]
    },
    {
      "id": "body-not-painted-foal",
      "description": "Coat layers carry the full silhouette; the build axis is selection-only",
      "when": { "body": "foal" },
      "hide": ["body"]
    },
    {
      "id": "mane-not-painted",
      "description": "Coat masters still include mane and tail; the mane axis is selection-only until hair is split",
      "when": { "body": ["standard", "foal"] },
      "hide": ["mane"]
    },
    {
      "id": "standard-hides-foal-coat",
      "description": "Adult coats are used for the standard build",
      "when": { "body": "standard" },
      "hide": ["coat-foal"]
    },
    {
      "id": "foal-hides-standard-coat",
      "description": "Foal coats are used for the foal build",
      "when": { "body": "foal" },
      "hide": ["coat"]
    },
    {
      "id": "foal-hides-adult-overlays",
      "description": "Adult pie, face markings and equipment are authored for the adult silhouette",
      "when": { "body": "foal" },
      "hide": ["pie", "markings", "equipment"]
    },
    {
      "id": "standard-hides-foal-pie",
      "description": "Adult pie overlays are used for the standard build",
      "when": { "body": "standard" },
      "hide": ["pie-foal"]
    },
    {
      "id": "standard-hides-foal-markings",
      "description": "Adult face markings are used for the standard build",
      "when": { "body": "standard" },
      "hide": ["markings-foal"]
    },
    {
      "id": "pie-hides-markings",
      "description": "These pinto patterns already carry face white, so separate markings are not painted; tobiano keeps a solid head and allows them",
      "when": {
        "pie": ["tovero", "overo", "splashed-white", "sabino"]
      },
      "hide": ["markings"]
    },
    {
      "id": "foal-pie-hides-foal-markings",
      "description": "These foal pinto patterns already carry face white, so separate markings are not painted; tobiano keeps a solid head and allows them",
      "when": {
        "pie-foal": ["tovero", "overo", "splashed-white", "sabino"]
      },
      "hide": ["markings-foal"]
    },
    {
      "id": "armor-hides-markings",
      "description": "Plate armour covers the head, so face markings are not rendered",
      "when": { "equipment": "armor" },
      "hide": ["markings"]
    }
  ],
  "variants": {
    "axes": ["coat", "equipment"],
    "include": { "body": "standard", "mane": "short" },
    "name": "{plugin}-{coat}-{equipment}"
  },
  "exports": {
    "formats": ["png", "webp"],
    "thumbnail": { "width": 128 },
    "metadata": true
  }
}
