          "tags": ["light"]
        },
        {
          "id": "isabelle",
          "title": "Isabelle",
          "asset": "layers/coat/isabelle.png",
          "tags": ["light"]
        },
        {
          "id": "cream",
          "title": "Cream",
          "asset": "layers/coat/cream.png",
          "tags": ["light"]
        }
      ]
    },
    {
      "id": "coat-foal",
      "title": "Coat",
      "order": 20,
      "required": true,
      "dependsOn": ["body"],
      "opacity": 1,
      "blendMode": "normal",
      "options": [
        {
