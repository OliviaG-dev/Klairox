          "title": "Tobiano",
          "asset": "layers/pie-foal/tobiano.png"
        },
        {
          "id": "tovero",
          "title": "Tovero",
          "asset": "layers/pie-foal/tovero.png"
        },
        {
          "id": "overo",
          "title": "Overo",
          "asset": "layers/pie-foal/overo.png"
        },
