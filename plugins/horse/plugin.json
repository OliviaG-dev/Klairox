    {
      "id": "markings",
      "title": "Face markings",
      "order": 30,
      "dependsOn": ["coat", "pie"],
      "options": [
        {
          "id": "blaze",
          "title": "Blaze (liste)",
          "asset": "layers/markings/Standard-OC/blaze.png"
        },
        {
          "id": "thin-blaze",
          "title": "Thin blaze (fine liste)",
          "asset": "layers/markings/Standard-OC/thin-blaze.png"
        },
        {
          "id": "stripe",
          "title": "Stripe (race)",
          "asset": "layers/markings/Standard-OC/stripe.png"
        },
        {
          "id": "star",
          "title": "Star (étoile)",
          "asset": "layers/markings/Standard-OC/star.png"
        },
        {
          "id": "diamond",
