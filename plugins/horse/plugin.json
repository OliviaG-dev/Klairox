    },
    {
      "id": "pie",
      "title": "Pie",
      "order": 25,
      "dependsOn": ["coat"],
      "opacity": 1,
      "blendMode": "normal",
      "options": [
        {
          "id": "tobiano",
          "title": "Tobiano",
          "asset": "layers/pie/tobiano.png"
        },
        {
          "id": "tovero",
