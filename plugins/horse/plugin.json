{
  "$schema": "../../schemas/plugin.schema.json",
  "name": "horse",
  "version": "1.0.0",
  "title": "Horse",
  "description": "Reference plugin: a layered horse assembled from photoreal coats on a shared silhouette.",
  "license": "MIT",
  "canvas": {
    "width": 512,
    "height": 512
  },
  "layers": [
    {
      "id": "body",
      "title": "Build",
      "order": 10,
      "required": true,
      "options": [
        {
          "id": "standard",
          "title": "Standard-OC",
          "asset": "layers/body/standard.png"
        },
        {
          "id": "foal",
          "title": "Foal",
          "asset": "layers/body/foal.png"
        }
      ]
    },
    {
      "id": "coat",
      "title": "Coat",
      "order": 20,
      "required": true,
      "dependsOn": ["body"],
      "opacity": 1,
      "blendMode": "normal",
      "options": [
        {
          "id": "bay",
          "title": "Bay",
          "asset": "layers/coat/bay.png",
          "tags": ["dark"]
        },
        {
          "id": "bay-brun",
