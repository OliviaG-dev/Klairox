        {
          "id": "chestnut",
          "title": "Chestnut",
          "asset": "layers/coat-foal/chestnut.png"
        },
        {
          "id": "grey",
          "title": "Grey",
          "asset": "layers/coat-foal/grey.png",
          "tags": ["light"]
        },
        {
          "id": "roan",
          "title": "Roan",
          "asset": "layers/coat-foal/roan.png",
